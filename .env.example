# Supabase project credentials.
# Copy this file to .env (local) or set these in EAS secrets for builds.
#
# Values come from the Supabase dashboard:
#   Project Settings -> API -> Project URL
#   Project Settings -> API -> anon (public) key
#
# EXPO_PUBLIC_ prefix: these are shipped to the client. That is correct for the
# URL and anon key (both are designed to be public). Never ship the service_role
# key or JWT secret this way.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: AI provider for solo-mode journaling coach. Called only from an
# Edge Function, never from the client, so no EXPO_PUBLIC_ prefix.
# Set these as Supabase Edge Function secrets:
#   supabase secrets set ANTHROPIC_API_KEY=...
#
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
