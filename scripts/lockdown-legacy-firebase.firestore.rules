// Legacy Firebase / Firestore Lockdown Ruleset for YesYas!
//
// Background:
// The early web prototype (v0.1-web-prototype / v0.2-web-prototype-hardened)
// targeted the legacy Firebase project `gen-lang-client-0707391511`.
// YesYas! v1 runs exclusively on Expo + Supabase (PostgreSQL with Row-Level
// Security and hardened SECURITY DEFINER RPCs).
//
// How to deploy this deny-all tombstone ruleset to permanently lock down the
// legacy Firestore database:
//   1. Install Firebase CLI if needed: `npm install -g firebase-tools`
//   2. Authenticate: `firebase login`
//   3. Deploy this rules file directly to `gen-lang-client-0707391511`:
//      `firebase deploy --only firestore:rules --project gen-lang-client-0707391511`
//      (or paste the contents below into the Firebase Console -> Firestore Database -> Rules tab).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
